# Copiar a .env y rellenar. NUNCA commitear el .env real.

# Base de datos (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Backend
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
BETTER_AUTH_URL="http://localhost:4000"
SESSION_SECRET="cambiar-por-un-secreto-de-al-menos-32-caracteres"

# Spotify (solo backend; crear la app en el Dashboard de Spotify)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:4000/api/v1/spotify/callback"

# Web (Vite: exponer solo variables públicas)
VITE_API_BASE_URL="http://localhost:4000/api/v1"

# Mobile (Expo: exponer solo variables públicas)
EXPO_PUBLIC_API_BASE_URL="http://localhost:4000/api/v1"
