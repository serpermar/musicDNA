{
  "name": "@musicdna/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema ../../database/prisma/schema.prisma",
    "db:seed": "tsx ../../database/scripts/seed.ts",
    "db:migrate": "prisma migrate dev --schema ../../database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../../database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema ../../database/prisma/schema.prisma"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.25",
    "@musicdna/music-engine": "workspace:*",
    "@musicdna/quiz-engine": "workspace:*",
    "@musicdna/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.16.2",
    "better-auth": "^1.7.25",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
