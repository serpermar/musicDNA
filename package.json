{
  "name": "musicdna",
  "version": "0.1.0",
  "private": true,
  "description": "Your music. Your personality. Your DNA.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @musicdna/backend db:generate",
    "db:migrate": "pnpm --filter @musicdna/backend db:migrate",
    "db:seed": "pnpm --filter @musicdna/backend db:seed",
    "db:studio": "pnpm --filter @musicdna/backend db:studio"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
